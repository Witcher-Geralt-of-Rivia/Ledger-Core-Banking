# Example environment configuration for the dashboard.
#
# Local development: copy to .env.local (git-ignored) if you need an override.
# Hosted builds:     set these in the hosting provider (e.g. Vercel project settings).
#
# VITE_* values are compiled into the client bundle and are publicly visible.
# Never put credentials, API keys, tokens or other secrets in them.

# Origin of the backend API: scheme and host only, no trailing slash and no /api path.
#
# Leave it unset when a same-origin reverse proxy forwards /api to the backend
# (the Vite dev server, or nginx in docker-compose). Set it on static hosts such as
# Vercel, where the browser calls the backend directly.
VITE_API_BASE_URL=https://your-backend.example.com
